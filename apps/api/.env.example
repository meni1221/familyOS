# ─────────────────────────────────────────────────────────────────────────────
# Shlanu API — development environment
# Copy to .env and fill in. Every key here is read by the code; the server
# refuses to start when a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# The two origins the app is served from. The CSRF check compares them, so they
# must match what the browser actually sends.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# MongoDB. DATABASE_NAME is the fallback when the URL names no database.
DATABASE_URL="mongodb://localhost:27017/Shlanu"
DATABASE_NAME=Shlanu

# Optional: DNS servers for this process, comma-separated IPs. Set it only when
# the host's resolver list is broken and `mongodb+srv` fails with
# `querySrv ECONNREFUSED`. Leave it out on a healthy host.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Rate limiting, per client IP: the window in milliseconds, then the cap inside it.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# error | warn | info | debug | verbose
LOG_LEVEL=info

# json (one object per line, what a log collector wants) | pretty (for a terminal)
LOG_FORMAT=pretty

# Mail, optional. Without it the app still runs: password reset links are
# written to the log in development, and not sent at all in production.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM="שלנו <no-reply@shlanu.app>"
