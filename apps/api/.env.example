# ════════════════════════════════════════════════════════════════════════════════
# FamilyOS — Production Environment Configuration (MongoDB)
# ════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://app.familyos.app
API_URL=https://api.familyos.app

# ─────────────────────────────────────────────────────────────────────────────
# Database — MongoDB
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="mongodb://localhost:27017/FamilyOs"

# ─────────────────────────────────────────────────────────────────────────────
# Session & Authentication
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
SESSION_MAX_AGE=2592000000
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=familyos.app

# ─────────────────────────────────────────────────────────────────────────────
# Password Hashing (bcrypt)
# ─────────────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
# File Storage — local disk
# ─────────────────────────────────────────────────────────────────────────────
# Documents are stored on the API server's filesystem under UPLOADS_DIR
# (defaults to <api working directory>/uploads). Cloud/object storage is not
# implemented yet; STORAGE_* variables below are placeholders for a future
# S3-compatible provider and are currently ignored by the code.
UPLOADS_DIR=
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,image/webp,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Legacy placeholders (not used by the current local-disk implementation)
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_CDN_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Email — Optional
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@familyos.app
EMAIL_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
INVITATION_RATE_LIMIT_MAX_REQUESTS=10

# ─────────────────────────────────────────────────────────────────────────────
# Security Headers
# ─────────────────────────────────────────────────────────────────────────────
CSP_DEFAULT_SRC="'self'"
CSP_CONNECT_SRC="'self' https://api.familyos.app wss://api.familyos.app"
CSP_IMG_SRC="'self' https: data:"
CSP_STYLE_SRC="'self' 'unsafe-inline' https://fonts.googleapis.com"
CSP_FONT_SRC="'self' https://fonts.gstatic.com"
HSTS_MAX_AGE=31536000

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ─────────────────────────────────────────────────────────────────────────────
# Feature Flags
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_BABY_TRACKER=true
ENABLE_DOCUMENTS=true
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_SOCKET_IO=true

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring (Optional)
# ─────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
