# ─────────────────────────────────────────────────────────────────────────────
# Shlanu API — development environment
# Copy to .env and fill in. Every key here is read by the code; the server
# refuses to start when a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# The two origins the app is served from. The CSRF check compares them, so they
# must match what the browser actually sends.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001

# MongoDB. DATABASE_NAME is the fallback when the URL names no database.
DATABASE_URL="mongodb://localhost:27017/Shlanu"
DATABASE_NAME=Shlanu

# Rate limiting, per client IP: the window in milliseconds, then the cap inside it.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# error | warn | info | debug | verbose
LOG_LEVEL=info
