# Production environment — copy to .env.production and fill in actual values
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://app.shlanu.app
API_URL=https://api.shlanu.app

DATABASE_URL="mongodb://USER:PASSWORD@HOST:27017/DBNAME"

SESSION_SECRET=CHANGE_ME
SESSION_MAX_AGE=2592000000
COOKIE_SECURE=true
COOKIE_SAME_SITE=strict
COOKIE_DOMAIN=shlanu.app

BCRYPT_SALT_ROUNDS=12

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shlanu.app
EMAIL_ENABLED=false

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5

LOG_LEVEL=warn
LOG_FORMAT=json

SENTRY_DSN=
SENTRY_ENVIRONMENT=production
