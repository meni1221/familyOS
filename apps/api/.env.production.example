# ─────────────────────────────────────────────────────────────────────────────
# Shlanu API — production environment
# Copy to .env.production and fill in. Every key here is read by the code; the
# server refuses to start when a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3001

# The two origins the app is served from — the browser and the API as people
# reach them. The CSRF check compares them exactly.
FRONTEND_URL=https://app.shlanu.app
API_URL=https://api.shlanu.app

DATABASE_URL="mongodb://USER:PASSWORD@HOST:27017/Shlanu?authSource=admin"
DATABASE_NAME=Shlanu

# Optional: DNS servers for this process, comma-separated IPs. Set it only when
# the host's resolver list is broken and `mongodb+srv` fails with
# `querySrv ECONNREFUSED`. Leave it out on a healthy host.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Rate limiting, per client IP: the window in milliseconds, then the cap inside it.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# error | warn | info | debug | verbose
LOG_LEVEL=warn

# json keeps one object per line for a collector; pretty is for a terminal.
LOG_FORMAT=json

# Mail. Required for password reset to work: without it the API still starts,
# but a reset request is logged as an error and no mail is sent (the link is
# deliberately not written to a production log — a log is not a private channel).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=shlanu
SMTP_PASS=CHANGE_ME
SMTP_FROM="שלנו <no-reply@shlanu.app>"
