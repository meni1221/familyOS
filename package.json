{
  "name": "shlanu",
  "version": "0.1.0",
  "private": true,
  "description": "Family life management SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w packages/shared-types && npm run build -w apps/web && npm run build -w apps/api",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test -w apps/web && npm run test -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/api",
    "db:seed": "npm run db:seed -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
